# Per-device values (user.name, user.email, user.signingkey, commit.gpgsign)
# are written to ~/.gitconfig.local by the installers — never here.
[include]
  path = ~/.gitconfig.local

[init]
  defaultBranch = main

[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  s = status -sb
  undo = reset --soft HEAD~1
  nah = !git reset --hard && git clean -df
  sync = !git checkout main && git pull --rebase && git fetch --prune
[safe]
	directory = *
