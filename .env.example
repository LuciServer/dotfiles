# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
# ─────────────────────────────────────────────────────────────

# Your identity — used for git config and GPG key generation
GIT_NAME="Your Name"
GIT_EMAIL="your@email.com"

# ─────────────────────────────────────────────────────────────
# GPG key source (optional)
#
# If set, the installer will SSH into this host and import your
# existing GPG signing key from there.
#
# Prerequisites:
#   - The SOURCE host must have gpg installed and your key on it
#   - This machine's SSH public key (~/.ssh/*.pub) must already
#     be in authorized_keys on the source host, OR the source
#     host must allow password authentication (you will be prompted)
#
# Tip: use an SSH Host alias from ssh/config rather than
# user@hostname so the correct IdentityFile is picked up:
#   GPG_SOURCE_HOST=my-server        (matches Host in ssh/config)
#   GPG_SOURCE_HOST=user@1.2.3.4     (direct — may prompt for password)
#
# Leave blank to be prompted on whether to generate a fresh
# per-device key instead.
# ─────────────────────────────────────────────────────────────
GPG_SOURCE_HOST=""
