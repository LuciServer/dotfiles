listfiles() {
  if [ -n "$1" ]; then
    find . -type f \
      -not -path "*/.git/*" \
      -not -path "*/node_modules/*" \
      -not -path "*/.turbo/*" \
      -not -path "*/.pnpm-store/*" \
      -not -path "*/__pycache__/*" \
      -not -path "*/.venv/*" \
      -not -path "*/.pytest_cache/*" \
      -name "*$1" \
    | sed 's|^\./||'
  else
    find . -type f \
      -not -path "*/.git/*" \
      -not -path "*/node_modules/*" \
      -not -path "*/.turbo/*" \
      -not -path "*/.pnpm-store/*" \
      -not -path "*/__pycache__/*" \
      -not -path "*/.venv/*" \
      -not -path "*/.pytest_cache/*" \
    | sed 's|^\./||'
  fi
}
